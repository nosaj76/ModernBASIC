# Install in /etc/nginx/conf.d/modernbasic.conf (inside the http context).
# Replace bugs.example.org and certificate paths with the real deployment.
limit_req_zone $binary_remote_addr zone=mb_requests:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=mb_reports:10m rate=5r/m;
limit_conn_zone $binary_remote_addr zone=mb_connections:10m;

server {
    listen 80;
    server_name bugs.example.org;
    return 301 https://bugs.example.org$request_uri;
}
server {
    listen 443 ssl;
    server_name bugs.example.org;
    ssl_certificate /etc/letsencrypt/live/bugs.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bugs.example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 2m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    send_timeout 30s;
    limit_conn mb_connections 8;
    limit_req_status 429;
    limit_conn_status 429;
    access_log off;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Buffer complete client requests before forwarding to the loopback app.
    proxy_request_buffering on;
    proxy_set_header Host bugs.example.org;
    proxy_set_header Connection close;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;

    # Includes GETs: excessive refreshes of a report or login form are limited.
    location ~ ^/(report|login|v1/reports)$ {
        limit_req zone=mb_reports burst=5 nodelay;
        proxy_pass http://127.0.0.1:8081;
    }
    location /downloads/ {
        limit_req zone=mb_requests burst=10 nodelay;
        proxy_buffering off;
        proxy_pass http://127.0.0.1:8081;
    }
    location / {
        limit_req zone=mb_requests burst=20 nodelay;
        proxy_pass http://127.0.0.1:8081;
    }
}
